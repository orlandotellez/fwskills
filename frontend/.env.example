# Copia este archivo a `.env` y ajusta los valores.
# Las variables PUBLIC_* quedan expuestas al cliente (Astro).

# URL pública del sitio (la usa astro.config.mjs y el canonical del Layout)
PUBLIC_SITE_URL=https://example.com

# Descripción por defecto de la landing (usada en <meta name="description">)
PUBLIC_SITE_DESCRIPTION=Landing estática creada con fwinit y Astro