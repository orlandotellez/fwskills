# Copia este archivo a `.env` y ajusta los valores.
# Las variables PUBLIC_* quedan expuestas al cliente (Astro).

# URL pública del sitio. OBLIGATORIA para `bun run build`: sin ella el build
# falla en lugar de publicar un canonical y un sitemap apuntando a un dominio
# equivocado. En `bun run dev` no es necesaria: cae a http://localhost:4321.
PUBLIC_SITE_URL=https://example.com

# Descripción por defecto del sitio (usada en <meta name="description">)
PUBLIC_SITE_DESCRIPTION=Catálogo, documentación y CLI para instalar skills comunitarias en tu agente de IA.

# Token opcional de GitHub. Solo lo usa el build para resolver estrellas,
# releases y contribuyentes. Sin él la API va sin autenticar y tiene un
# límite de 60 requests por hora; con él el límite es 5000. Si no hay red,
# el build usa la caché y sigue.
# GITHUB_TOKEN=ghp_xxx
