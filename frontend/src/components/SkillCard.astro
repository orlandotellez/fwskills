---
import Badge from './Badge.astro';
import { authorList, installCommand, skillHref, type Skill } from '../lib/skills';

/**
 * Skill card. Used by the catalog grid, the landing's featured block, and the
 * related-skills row on a skill page — one card, three places, so the catalog
 * can never look like three different catalogs.
 */
export interface Props {
  skill: Skill;
  /** Runner for the quick-copy command. */
  runner?: string;
}

const { skill, runner = 'npx' } = Astro.props;
const command = installCommand(skill, runner);
const authors = authorList(skill);
---

<article class="card card--interactive skill-card">
  <div class="skill-card__head">
    <h3 class="skill-card__name">
      <a href={skillHref(skill)}>{skill.data.name}</a>
    </h3>
    <span class="skill-card__version">{skill.data.version}</span>
  </div>

  <p class="skill-card__desc">{skill.data.description}</p>

  <div class="skill-card__badges">
    <Badge variant="category">{skill.data.category}</Badge>
    {skill.data.compatibility.slice(0, 2).map((c) => (
      <Badge variant="compatibility">{c}</Badge>
    ))}
  </div>

  {
    skill.data.tags.length > 0 && (
      <ul class="skill-card__tags">
        {skill.data.tags.slice(0, 4).map((tag) => (
          <li>
            <span class="tag">{tag}</span>
          </li>
        ))}
      </ul>
    )
  }

  <div class="skill-card__foot">
    <a class="btn btn-primary btn--sm" href={skillHref(skill)}>
      Ver skill
    </a>
    <button
      class="btn btn-ghost btn--sm"
      type="button"
      data-copy
      data-code-value={command}
      data-copy-label="Comando de instalación"
    >
      <span data-copy-text>Copiar comando</span>
    </button>
  </div>

  {
    authors.length > 0 && (
      <p class="skill-card__author">
        por {authors.join(', ')}
      </p>
    )
  }
</article>

<style>
  .skill-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .skill-card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs);
  }

  /* The name always reads as code, so a skill is recognisable at a glance. */
  .skill-card__name {
    font-family: var(--font-mono);
    font-size: var(--text-body-sm);
    font-weight: 600;
    min-width: 0;
  }

  .skill-card__name a {
    color: var(--text);
  }

  .skill-card__name a:hover {
    color: var(--accent);
  }

  .skill-card__version {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .skill-card__desc {
    font-size: var(--text-body-sm);
    color: var(--text-secondary);
    /* Two lines, then ellipsis. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .skill-card__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
  }

  .skill-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
  }

  .skill-card__foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: auto;
    padding-block-start: var(--space-2xs);
  }

  .skill-card__author {
    font-size: var(--text-caption);
    color: var(--text-muted);
  }
</style>
