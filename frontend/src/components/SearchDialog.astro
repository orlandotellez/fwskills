---
/**
 * Search modal. Opens with Ctrl/⌘+K from anywhere, searches skills AND docs.
 *
 * The index is fetched once from /search-index.json, which is generated at
 * build time from the content collections — no runtime backend, no shipping a
 * large index in every page.
 */
---

<div class="search" data-search hidden>
  <div class="search__scrim" data-search-close></div>

  <div
    class="search__panel"
    role="dialog"
    aria-modal="true"
    aria-label="Buscar en fwskills"
  >
    <div class="search__field">
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        aria-hidden="true"
        focusable="false"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
      <input
        type="search"
        class="search__input"
        data-search-input
        placeholder="Buscar skills y documentación…"
        aria-label="Buscar skills y documentación"
        aria-controls="search-results"
        aria-describedby="search-status"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="search__kbd" aria-hidden="true">Esc</kbd>
    </div>

    <p class="search__status" id="search-status" data-search-status aria-live="polite"></p>

    <ul class="search__results" id="search-results" data-search-results></ul>

    <div class="search__hint">
      <span><kbd>↑</kbd><kbd>↓</kbd> navegar</span>
      <span><kbd>↵</kbd> abrir</span>
    </div>
  </div>
</div>

<!-- El comportamiento vive en src/scripts/search.ts -->

<style>
  .search {
    position: fixed;
    inset: 0;
    z-index: 150;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: var(--space-4xl) var(--space-md) var(--space-md);
  }

  .search[hidden] {
    display: none;
  }

  .search__scrim {
    position: absolute;
    inset: 0;
    background: var(--scrim);
  }

  .search__panel {
    position: relative;
    width: 100%;
    max-width: 640px;
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-pop);
    overflow: hidden;
  }

  .search__field {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-sm) var(--space-md);
    border-block-end: 1px solid var(--border);
    color: var(--text-muted);
  }

  .search__input {
    flex: 1;
    background: transparent;
    border: 0;
    color: var(--text);
    font-size: var(--text-body);
  }

  .search__input:focus-visible {
    outline: none;
  }

  .search__kbd,
  .search__hint kbd {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 2px 6px;
    background: var(--surface);
    border: 1px solid var(--border-input);
    border-radius: 4px;
    color: var(--text-muted);
  }

  .search__status {
    padding: var(--space-2xs) var(--space-md) 0;
    font-size: var(--text-caption);
    color: var(--text-muted);
  }

  .search__results {
    max-height: 50vh;
    overflow-y: auto;
    padding: var(--space-2xs);
  }

  .search__results:empty {
    padding: 0;
  }

  .search__link {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2xs) var(--space-xs);
    align-items: baseline;
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--radius-sm);
    color: var(--text);
  }

  .search__link:hover,
  .search__link.is-active {
    background: var(--accent-soft);
    color: var(--text);
  }

  .search__kind {
    font-size: var(--text-caption);
    color: var(--accent);
    font-weight: 600;
  }

  .search__title {
    font-weight: 600;
    font-size: var(--text-body-sm);
  }

  .search__desc {
    grid-column: 2;
    font-size: var(--text-caption);
    color: var(--text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .search__hint {
    display: flex;
    gap: var(--space-md);
    padding: var(--space-2xs) var(--space-md);
    border-block-start: 1px solid var(--border);
    font-size: var(--text-caption);
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .search {
      padding: var(--space-md);
    }
  }
</style>
