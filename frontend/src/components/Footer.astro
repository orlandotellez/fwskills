--- 
import { SITE } from '../lib/site';

interface FooterLink {
  href: string;
  label: string;
  external?: boolean;
}

const year = new Date().getFullYear();

const columns: { title: string; links: FooterLink[] }[] = [
  {
    title: 'Producto',
    links: [
      { href: '/skills', label: 'Skills' },
      { href: '/instalacion', label: 'Instalación' },
      { href: '/docs/introduccion/', label: 'Docs' },
      { href: '/docs/changelog/', label: 'Changelog' },
    ],
  },
  {
    title: 'Comunidad',
    links: [
      { href: '/contribuir', label: 'Contribuir' },
      { href: SITE.conduct, label: 'Código de conducta', external: true },
      { href: SITE.governance, label: 'Gobernanza', external: true },
      { href: SITE.newIssue, label: 'Reportar un problema', external: true },
    ],
  },
  {
    title: 'Recursos',
    links: [
      { href: SITE.github, label: 'GitHub', external: true },
      { href: SITE.npm, label: 'npm', external: true },
      { href: SITE.licenseFile, label: 'Licencia', external: true },
      { href: SITE.security, label: 'Seguridad', external: true },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a class="wordmark" href="/">
        <span class="wordmark__mark" aria-hidden="true">◆</span>
        <span>{SITE.name}</span>
      </a>
      <p class="site-footer__tagline">{SITE.tagline}. Instalá con un comando.</p>
      <ul class="site-footer__social">
        <li>
          <a href={SITE.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M12 .5C5.73.5.5 5.73.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.4-5.25 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"
              ></path>
            </svg>
          </a>
        </li>
        <li>
          <a href={SITE.npm} target="_blank" rel="noopener noreferrer" aria-label="npm">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M0 7.5v9h1.5V9h1.5v7.5h3V9h1.5v7.5h1.5V7.5H0Zm9 0v9h9v-9H9Zm1.5 1.5h6v6h-6V9Z"
              ></path>
            </svg>
          </a>
        </li>
        <li>
          <a
            href={SITE.community}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Comunidad"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9 9 0 0 1-3.9-.9L3 20.5l1.6-4.7A8.4 8.4 0 0 1 12 3.1a8.4 8.4 0 0 1 9 8.4Z"
              ></path>
            </svg>
          </a>
        </li>
      </ul>
    </div>

    {
      columns.map((col) => (
        <nav class="site-footer__col" aria-label={col.title}>
          <h2 class="site-footer__heading">{col.title}</h2>
          <ul>
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="container site-footer__bar">
    <p>© {year} {SITE.name}. Proyecto open source bajo licencia {SITE.license}. Hecho por la comunidad.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface);
    border-block-start: 1px solid var(--border);
    margin-block-start: var(--space-3xl);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-xl);
    padding-block: var(--space-2xl);
  }

  .site-footer__tagline {
    margin-block: var(--space-2xs) var(--space-sm);
    font-size: var(--text-body-sm);
    color: var(--text-secondary);
    max-width: 34ch;
  }

  .site-footer__social {
    display: flex;
    gap: var(--space-2xs);
  }

  .site-footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    border: 1px solid var(--border);
    transition:
      color var(--duration-fast) ease,
      border-color var(--duration-fast) ease;
  }

  .site-footer__social a:hover {
    color: var(--accent);
    border-color: var(--accent-border);
  }

  .site-footer__heading {
    font-size: var(--text-caption);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-block-end: var(--space-2xs);
  }

  .site-footer__col ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .site-footer__col a {
    font-size: var(--text-body-sm);
    color: var(--text-secondary);
  }

  .site-footer__col a:hover {
    color: var(--accent);
  }

  .site-footer__bar {
    padding-block: var(--space-md);
    border-block-start: 1px solid var(--border);
  }

  .site-footer__bar p {
    font-size: var(--text-caption);
    color: var(--text-muted);
  }

  @media (max-width: 1024px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 768px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
</style>
