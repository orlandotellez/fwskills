---
import { NAV, SITE } from '../lib/site';
import { getGitHubData, formatCount } from '../lib/github';
import SearchDialog from './SearchDialog.astro';

const github = await getGitHubData();
const path = Astro.url.pathname;

/** A nav item is active on its own route and on anything nested under it. */
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header" data-site-header>
  <div class="container site-header__inner">
    <a class="wordmark" href="/" aria-label={`${SITE.name} — inicio`}>
      <span class="wordmark__mark" aria-hidden="true">◆</span>
      <span class="wordmark__text">{SITE.name}</span>
    </a>

    <nav class="site-nav" aria-label="Principal">
      <ul class="site-nav__list">
        {
          NAV.map((item) => (
            <li>
              <a
                class="site-nav__link"
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <button class="btn-icon" type="button" data-search-open aria-label="Buscar (Ctrl+K)">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          aria-hidden="true"
          focusable="false"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
      </button>

      <a
        class="btn-icon"
        href={SITE.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${SITE.name} en GitHub${github.repo.stars ? `, ${github.repo.stars} estrellas` : ''}`}
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M12 .5C5.73.5.5 5.73.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.4-5.25 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"
          ></path>
        </svg>
        {github.repo.stars !== null && (
          <span class="star-count">{formatCount(github.repo.stars)}</span>
        )}
      </a>

      <button
        class="btn-icon"
        type="button"
        data-theme-toggle
        aria-pressed="false"
        aria-label="Cambiar a modo claro"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path>
        </svg>
      </button>

      <button
        class="btn-icon site-header__burger"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          aria-hidden="true"
          focusable="false"
        >
          <path class="burger-line burger-line--top" d="M4 7h16"></path>
          <path class="burger-line burger-line--mid" d="M4 12h16"></path>
          <path class="burger-line burger-line--bot" d="M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <nav aria-label="Menú móvil">
      <ul class="mobile-menu__list">
        {
          NAV.map((item) => (
            <li>
              <a
                class="mobile-menu__link"
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="btn btn-secondary" href={SITE.github} target="_blank" rel="noopener noreferrer">
      Ver en GitHub
    </a>
  </div>
</header>

<SearchDialog />

<!-- El comportamiento vive en src/scripts/index.ts -->

<style>
  .site-header {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    height: var(--header-height);
    z-index: 100;
    background: var(--base);
    border-block-end: 1px solid transparent;
    transition:
      background-color var(--duration-base) ease,
      border-color var(--duration-base) ease;
  }

  /* Translucent + blur past 40px of scroll. */
  .site-header[data-scrolled] {
    background: color-mix(in srgb, var(--base) 82%, transparent);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    box-shadow: var(--shadow-header);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    height: 100%;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    font-weight: 600;
    font-size: var(--text-body);
    color: var(--text);
    flex-shrink: 0;
  }

  .wordmark__mark {
    color: var(--accent);
    font-size: 0.7em;
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .site-nav__link {
    position: relative;
    display: inline-block;
    padding-block: var(--space-2xs);
    font-size: var(--text-body-sm);
    font-weight: 500;
    color: var(--text-secondary);
  }

  .site-nav__link:hover {
    color: var(--text);
  }

  /* The underline animates via scaleX, not via colour. */
  .site-nav__link::after {
    content: '';
    position: absolute;
    inset-block-end: 0;
    inset-inline: 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .site-nav__link:hover::after {
    transform: scaleX(1);
  }

  .site-nav__link[aria-current='page'] {
    color: var(--text);
  }

  .site-nav__link[aria-current='page']::after {
    transform: scaleX(1);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    flex-shrink: 0;
  }

  .star-count {
    font-size: var(--text-caption);
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
  }

  .site-header__burger {
    display: none;
  }

  /* The three lines collapse into an X. */
  .burger-line {
    transition:
      transform var(--duration-base) var(--ease-out),
      opacity var(--duration-fast) ease;
    transform-origin: center;
  }

  [data-menu-toggle][aria-expanded='true'] .burger-line--top {
    transform: translateY(5px) rotate(45deg);
  }
  [data-menu-toggle][aria-expanded='true'] .burger-line--mid {
    opacity: 0;
  }
  [data-menu-toggle][aria-expanded='true'] .burger-line--bot {
    transform: translateY(-5px) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 99;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-lg);
    padding: var(--space-xl);
    background: var(--surface-elevated);
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .mobile-menu__link {
    display: block;
    font-size: var(--text-h3);
    font-weight: 600;
    color: var(--text);
  }

  @media (max-width: 768px) {
    .site-nav {
      display: none;
    }
    .site-header__burger {
      display: inline-flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav__link::after,
    .burger-line {
      transition: none;
    }
  }
</style>
