---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/utilities.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative path to the social preview image. */
  ogImage?: string;
  /** Keep chrome out of pages that render their own full-bleed layout. */
  bare?: boolean;
  /** Ask search engines not to index this page (e.g. the 404). */
  noindex?: boolean;
}

const {
  title = 'fwskills — Skills comunitarias para agentes de IA',
  description =
    import.meta.env.PUBLIC_SITE_DESCRIPTION ??
    'Catálogo, documentación y CLI para instalar skills comunitarias en tu agente de IA.',
  ogImage = '/og-default.svg',
  bare = false,
  noindex = false,
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? '';
const canonical = siteUrl ? new URL(Astro.url.pathname, siteUrl).href : Astro.url.pathname;
const ogImageUrl = siteUrl ? new URL(ogImage, siteUrl).href : ogImage;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!--
      Anti-flash. Runs before the first paint and is the ONLY place that
      writes the initial data-theme. src/scripts/theme.ts handles changes and
      deliberately does not write on load — two writers would race.
    -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('fwskills:theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch (e) {
          /* storage blocked: the system preference applies via CSS */
        }
      })();
    </script>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="fwskills" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <title>{title}</title>
  </head>

  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!--
      Single entry point for every client behaviour (spec 02 T2). It is a
      module script in the body, not a bundled island, so the site ships no
      framework runtime. `init()` is idempotent, which matters because Astro
      re-evaluates this module after a client-side navigation: a delegated
      listener registered twice would fire twice.
    -->
    <script>
      import { init } from '../scripts/index';
      init();
    </script>
  </body>
</html>

<style is:global>
  main {
    padding-top: var(--header-height);
  }

  /* Chrome is always present; `bare` is for pages that own their own shell. */
  body:has(main > .full-bleed:first-child) main {
    padding-top: 0;
  }
</style>
