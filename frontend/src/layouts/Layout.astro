---
export interface Props {
  title?: string;
  description?: string;
}

const { title = 'fwinit — ¡Hola!', description = import.meta.env.PUBLIC_SITE_DESCRIPTION ?? 'Landing estática creada con fwinit y Astro' } = Astro.props;
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? '';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={siteUrl} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* ── Design tokens: marca fwinit · tema oscuro ── */
  :root {
    --bg-base: #000000;
    --bg-surface: #000000;
    --bg-card: #0a0a0a;
    --bg-elevated: #111111;

    --text-primary: #f1f5f9;
    --text-secondary: #94a3b8;
    --text-muted: #64748b;
    --text-on-primary: #ffffff;
    --text-accent: #8aa2ff;

    --primary: #04092e;
    --primary-dark: #8aa2ff;
    --primary-light: #0d1745;

    --secondary: #38bdf8;
    --secondary-light: #16324a;

    --accent-teal: #2dd4bf;
    --accent-amber: #fbbf24;

    --border: #1e293b;
    --border-strong: #334155;

    --footer-bg: #000000;
    --cta-bg: #0a1340;

    --font-heading: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --font-body: system-ui, -apple-system, 'Segoe UI', sans-serif;

    --text-xs: 0.75rem;
    --text-sm: 0.875rem;
    --text-base: 1rem;
    --text-lg: 1.125rem;
    --text-xl: 1.375rem;
    --text-2xl: 1.75rem;
    --text-3xl: 2.25rem;
    --text-4xl: 3rem;
    --text-5xl: 3.75rem;

    --space-xs: 0.25rem;
    --space-sm: 0.5rem;
    --space-md: 1rem;
    --space-lg: 1.5rem;
    --space-xl: 2rem;
    --space-2xl: 3rem;
    --space-3xl: 4rem;
    --space-4xl: 6rem;

    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-xl: 20px;
    --radius-pill: 9999px;

    --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.4);
    --shadow-md: 0 4px 20px rgba(0, 0, 0, 0.45);
    --shadow-lg: 0 8px 32px rgba(0, 0, 0, 0.55);
    --shadow-xl: 0 16px 48px rgba(0, 0, 0, 0.65);

    --max-width: 1200px;
    --header-height: 72px;
  }

  *, *::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--text-primary);
    background-color: var(--bg-base);
    line-height: 1.7;
    overflow-x: hidden;
  }

  a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }

  img, svg {
    display: block;
    max-width: 100%;
  }

  ul, ol {
    list-style: none;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading);
    font-weight: 700;
    line-height: 1.2;
    color: var(--text-primary);
  }

  .container {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-xl);
  }

  .section {
    padding: var(--space-4xl) 0;
  }

  .section-eyebrow {
    /* centrado con el título de sección: flex de bloque, ancho de
       contenido y márgenes automáticos (el inline-flex quedaría a la
       izquierda mientras el h2 se centra con text-align) */
    display: flex;
    width: fit-content;
    margin-inline: auto;
    align-items: center;
    gap: var(--space-sm);
    padding: 0.25rem 0.75rem;
    background: var(--primary-light);
    color: var(--primary-dark);
    font-size: var(--text-sm);
    font-weight: 600;
    border-radius: var(--radius-pill);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .section-title {
    font-size: var(--text-3xl);
    text-align: center;
    margin: var(--space-md) 0 var(--space-sm);
    color: var(--text-primary);
  }

  .section-subtitle {
    font-size: var(--text-lg);
    text-align: center;
    color: var(--text-secondary);
    max-width: 640px;
    margin: 0 auto var(--space-3xl);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    padding: 0.875rem 2rem;
    background: var(--primary);
    color: var(--text-on-primary);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    border: none;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 14px rgba(4, 9, 46, 0.6);
  }

  .btn-primary:hover {
    background: var(--primary-dark);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(4, 9, 46, 0.75);
  }

  .btn-primary:active {
    transform: translateY(0);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    padding: 0.875rem 2rem;
    background: transparent;
    color: var(--primary-dark);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    border: 2px solid var(--primary-dark);
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .btn-secondary:hover {
    background: var(--primary);
    color: var(--text-on-primary);
    transform: translateY(-2px);
  }

  .btn-light {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    padding: 0.875rem 2rem;
    background: var(--text-on-primary);
    color: var(--primary-dark);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    border: none;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .btn-light:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
  }

  .card {
    background: var(--bg-card);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    box-shadow: var(--shadow-md);
    transition: all 0.3s ease;
    border: 1px solid var(--border);
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--primary-light);
  }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 0.25rem 0.75rem;
    background: var(--primary-light);
    color: var(--primary-dark);
    font-size: var(--text-xs);
    font-weight: 600;
    border-radius: var(--radius-pill);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
    align-items: center;
  }

  .grid-3 {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: var(--space-xl);
  }

  .grid-4 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-xl);
  }

  @media (max-width: 1024px) {
    .grid-4 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    :root {
      --text-4xl: 2.25rem;
      --text-5xl: 2.75rem;
      --space-4xl: 4rem;
    }

    .section {
      padding: var(--space-3xl) 0;
    }

    .section-title {
      font-size: var(--text-2xl);
    }

    .grid-2, .grid-3, .grid-4 {
      grid-template-columns: 1fr;
    }

    .container {
      padding: 0 var(--space-md);
    }
  }

  @media (max-width: 480px) {
    .btn-primary, .btn-secondary, .btn-light {
      width: 100%;
    }
  }

  ::-webkit-scrollbar {
    width: 8px;
  }

  ::-webkit-scrollbar-track {
    background: var(--bg-base);
  }

  ::-webkit-scrollbar-thumb {
    background: var(--primary-light);
    border-radius: var(--radius-pill);
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--primary);
  }

  ::selection {
    background: var(--primary-light);
    color: var(--text-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      transition-duration: 0.01ms !important;
    }

    html {
      scroll-behavior: auto;
    }
  }
</style>