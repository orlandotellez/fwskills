---
import Layout from '../layouts/Layout.astro';
import PackageTabs from '../components/PackageTabs.astro';
import SkillCard from '../components/SkillCard.astro';
import Accordion from '../components/Accordion.astro';
import { getCategories, getFeatured, getSkills } from '../lib/skills';
import { getGitHubData } from '../lib/github';
import { SITE } from '../lib/site';

const [categories, featured, skills, github] = await Promise.all([
  getCategories(),
  getFeatured(6),
  getSkills(),
  getGitHubData(),
]);

const totalTags = new Set(skills.flatMap((s) => s.data.tags)).size;

/**
 * The three steps double as the landing's quick access (spec 02 T14).
 *
 * Each `href` is a real route, so no internal link can 404 — which is the
 * whole point of replacing the old `#caracteristicas` / `#skills` /
 * `#como-funciona` anchors with the shared header navigation.
 */
const steps = [
  {
    n: '01',
    title: 'Elige',
    body: 'Explora el catálogo por categoría, busca por nombre o filtra por tags hasta dar con la skill que falta.',
    href: '/skills',
    cta: 'Ver el catálogo',
  },
  {
    n: '02',
    title: 'Instala',
    body: 'Un comando. El CLI resuelve la categoría, descarga la skill y la deja en la carpeta del agente que ya tenés.',
    href: '/instalacion',
    cta: 'Ver la instalación',
  },
  {
    n: '03',
    title: 'Usa',
    body: 'Tu agente detecta la skill en su carpeta y la aplica. Sin configuración, sin registro, sin cuenta.',
    href: '/docs/introduccion/',
    cta: 'Leer la documentación',
  },
];

const faq = [
  {
    question: '¿Qué es una skill?',
    content:
      '<p>Una carpeta con un archivo <code>SKILL.md</code> que le dice a tu agente de IA <strong>cómo</strong> hacer una tarea concreta. No es código que vos ejecutás: es contexto que tu agente lee y sigue. Por eso instalar una skill es copiar una carpeta.</p>',
  },
  {
    question: '¿Con qué agentes funciona?',
    content:
      '<p>Con cualquier agente que lea skills desde una carpeta propia. Hoy está verificado en <code>opencode</code>, <code>agents</code> y <code>pi</code>. El campo <code>compatibility</code> de cada skill declara con cuáles funciona.</p>',
  },
  {
    question: '¿Es gratis?',
    content:
      `<p>Sí. El proyecto es open source bajo licencia ${SITE.license} y el catálogo es público. No hay cuentas, ni planes, ni telemetría.</p>`,
  },
  {
    question: '¿Cómo contribuyo?',
    content:
      '<p>Creás una carpeta en <code>skills/&lt;categoría&gt;/&lt;tu-skill&gt;/</code>, completás el <code>SKILL.md</code> y abrís un PR. La barra está puesta para que tu primera skill esté lista en menos de 15 minutos. <a href="/contribuir">Guía de contribución →</a></p>',
  },
  {
    question: '¿Cómo se revisa la calidad?',
    content:
      '<p>Todo PR pasa por revisión humana. El checklist exige descripción clara, casos de uso, ejemplos, ausencia de secretos, licencia compatible y al menos un agente donde se haya probado. Las skills con scripts ejecutables tienen revisión obligatoria.</p>',
  },
];
---

<Layout
  title={`${SITE.name} — ${SITE.tagline}`}
  description={SITE.description}
  ogImage="/og-default.svg"
>
  <!-- ── 3.1 Hero ─────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__text">
        <p class="section-eyebrow">Skills comunitarias para agentes de IA</p>
        <h1 class="hero__title">
          Skills que tu agente <span class="hero__accent">ya sabe usar</span>
        </h1>
        <p class="hero__lede">
          {SITE.name} es un catálogo abierto de skills para agentes de IA. Cada skill es una
          carpeta con un <code>SKILL.md</code> que le dice a tu agente cómo hacer una tarea
          concreta. Se instalan con un comando y funcionan en el agente que ya tenés.
        </p>

        <div class="hero__actions">
          <a class="btn btn-primary" href="/skills">Explorar skills</a>
          <a class="btn btn-secondary" href={SITE.github} target="_blank" rel="noopener noreferrer">
            Ver en GitHub
          </a>
        </div>

        <p class="hero__micro">
          Licencia {SITE.license} · {skills.length} skills · {github.contributors.length || '—'} ·
          playthrough
        </p>
      </div>

      <div class="hero__install" data-reveal>
        <p class="hero__install-label">Instala una skill</p>
        <PackageTabs command="fwskills add specs/create-specs" label="Comando de instalación" />
      </div>
    </div>
  </section>

  <!-- ── 3.2 Categorías ───────────────────────────────────────────────── -->
  <section class="section section--alt">
    <div class="container">
      <p class="section-eyebrow">Categorías</p>
      <h2 class="section-title">Una skill para cada etapa</h2>
      <p class="section-subtitle">
        Las categorías son carpetas. Agregar una nueva no requiere tocar el sitio: aparece sola.
      </p>

      <div class="grid-4" data-reveal-group>
        {
          categories.map((cat) => (
            <a class="card card--interactive cat-card" href={`/skills?categoria=${cat.slug}`}>
              <h3 class="cat-card__name">{cat.name}</h3>
              <p class="cat-card__desc">{cat.description}</p>
              <p class="cat-card__count">
                {cat.count} skill{cat.count === 1 ? '' : 's'}
                <span class="cat-card__go" aria-hidden="true">→</span>
              </p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── 3.3 Skills destacadas ─────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="section__head">
        <h2 class="section-heading">Skills destacadas</h2>
        <a class="section__more" href="/skills">Ver todas →</a>
      </div>

      {
        featured.length === 0 ? (
          <p class="empty">Todavía no hay skills marcadas como destacadas.</p>
        ) : (
          <div class="grid-3">
            {featured.map((skill) => (
              <SkillCard skill={skill} />
            ))}
          </div>
        )
      }
    </div>
  </section>

  <!-- ── 3.4 Cómo funciona ─────────────────────────────────────────────── -->
  <section class="section section--alt">
    <div class="container">
      <h2 class="section-title">Así de simple</h2>
      <ol class="steps">
        {
          steps.map((step) => (
            <li class="steps__item" data-reveal>
              <span class="steps__n" aria-hidden="true">
                {step.n}
              </span>
              <h3 class="steps__title">{step.title}</h3>
              <p class="steps__body">{step.body}</p>
              <a class="steps__link" href={step.href}>
                {step.cta}
                <span class="steps__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ── 3.5 Flujo de trabajo ─────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">Un flujo, no cajas sueltas</h2>
      <p class="section-subtitle">
        Las categorías encajan en un mismo recorrido. Cada etapa enlaza a su parte del catálogo.
      </p>

      <ol class="flow" data-reveal>
        {
          categories.map((cat, index) => (
            <li class="flow__step">
              {index > 0 && (
                <span class="flow__arrow" aria-hidden="true">
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </span>
              )}
              <a class="flow__node" href={`/skills?categoria=${cat.slug}`}>
                {cat.name}
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ── 3.6 Comunidad ────────────────────────────────────────────────── -->
  <section class="section section--alt">
    <div class="container">
      <h2 class="section-title">Hecho por la comunidad</h2>
      <p class="section-subtitle">
        Sin equipo cerrado y sin roadmap decidido por una empresa. Cada skill es una contribución
        pública y revisada.
      </p>

      <ul class="metrics">
        <li class="metrics__item">
          <span class="metrics__value">{skills.length}</span>
          <span class="metrics__label">Skills</span>
        </li>
        <li class="metrics__item">
          <span class="metrics__value">{github.contributors.length || '—'}</span>
          <span class="metrics__label">Contribuyentes</span>
        </li>
        <li class="metrics__item">
          <span class="metrics__value">{github.releases.length || '—'}</span>
          <span class="metrics__label">Releases</span>
        </li>
        <li class="metrics__item">
          <span class="metrics__value">{totalTags}</span>
          <span class="metrics__label">Tags</span>
        </li>
      </ul>

      {
        github.contributors.length > 0 && (
          <ul class="avatars">
            {github.contributors.slice(0, 12).map((c) => (
              <li>
                <a href={c.url} target="_blank" rel="noopener noreferrer">
                  <img
                    src={c.avatar}
                    alt={c.login}
                    width="40"
                    height="40"
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <p class="community__cta">
        <a class="btn btn-primary" href="/contribuir">Contribuye con tu skill</a>
      </p>
    </div>
  </section>

  <!-- ── 3.7 FAQ ──────────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container text-column">
      <h2 class="section-title">Preguntas frecuentes</h2>
      <Accordion items={faq} />
      <p class="section__more-wrap">
        <a class="section__more" href="/docs/faq/">Ver todas las preguntas →</a>
      </p>
    </div>
  </section>

  <!-- ── 3.8 CTA final ────────────────────────────────────────────────── -->
  <section class="cta">
    <div class="container cta__inner">
      <h2 class="cta__title">Instala tu primera skill ahora</h2>
      <p class="cta__body">
        Un comando, sin registro, sin tarjeta, sin límite de instalaciones.
      </p>
      <div class="cta__actions">
        <a class="btn btn-primary" href="/instalacion">Instalar ahora</a>
        <a class="btn btn-secondary" href="/contribuir">Contribuir</a>
      </div>
    </div>
  </section>
</Layout>


<style>

  .hero__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-2xl);
    align-items: center;
    min-height: 70vh;
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .hero__title {
    font-size: var(--text-display);
    line-height: 1.1;
  }

  .hero__accent {
    color: var(--accent);
  }

  .hero__lede {
    max-width: 560px;
    color: var(--text-secondary);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .hero__micro {
    font-size: var(--text-caption);
    color: var(--text-muted);
  }

  /* ── Section headings ───────────────────────────────────────────── */
  .section__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    margin-block-end: var(--space-lg);
  }

  .section__head .section-heading {
    margin-block-end: 0;
  }

  .section__more {
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
  }

  .section__more-wrap {
    margin-block-start: var(--space-md);
    text-align: center;
  }

  /* ── Category cards ─────────────────────────────────────────────── */
  .cat-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .cat-card__name {
    font-size: var(--text-h3);
    line-height: 1.3;
  }

  .cat-card__desc {
    font-size: var(--text-body-sm);
    color: var(--text-secondary);
    flex: 1;
  }

  .cat-card__count {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-size: var(--text-caption);
    color: var(--text-muted);
  }

  /* The arrow shifts 4px on hover. */
  .cat-card__go {
    transition: transform var(--duration-base) var(--ease-out);
  }

  .cat-card:hover .cat-card__go {
    transform: translateX(4px);
  }

  /* ── Steps ──────────────────────────────────────────────────────── */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .steps__item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .steps__n {
    font-family: var(--font-mono);
    font-size: 2.5rem;
    font-weight: 600;
    line-height: 1;
    color: var(--accent-soft-hover);
  }

  .steps__title {
    font-size: var(--text-h3);
    line-height: 1.3;
  }

  .steps__body {
    font-size: var(--text-body-sm);
    color: var(--text-secondary);
  }

  .steps__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-block-start: var(--space-2xs);
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--accent);
  }

  /* The arrow shifts on hover; the underline is the focus affordance. */
  .steps__arrow {
    transition: transform var(--duration-base) var(--ease-out);
  }

  .steps__link:hover .steps__arrow {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .steps__arrow {
      transition: none;
    }
  }

  /* ── Flow ───────────────────────────────────────────────────────── */
  .flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
  }

  .flow__step {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .flow__node {
    padding: var(--space-2xs) var(--space-md);
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--text);
  }

  .flow__node:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .flow__arrow {
    display: inline-flex;
    color: var(--border-strong);
  }

  /* ── Metrics ────────────────────────────────────────────────────── */
  .metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
    margin-block-end: var(--space-lg);
  }

  .metrics__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3xs);
  }

  .metrics__value {
    font-size: var(--text-h1);
    font-weight: 600;
    line-height: 1;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .metrics__label {
    font-size: var(--text-caption);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .avatars {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2xs);
    margin-block-end: var(--space-lg);
  }

  .avatars img {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
  }

  .community__cta {
    text-align: center;
  }

  /* ── Final CTA ──────────────────────────────────────────────────── */
  .cta {
    background: var(--accent-soft);
    border-block: 1px solid var(--accent-border);
    padding-block: var(--space-4xl);
  }

  .cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    text-align: center;
  }

  .cta__title {
    font-size: var(--text-h2);
    color: var(--text);
  }

  .cta__body {
    color: var(--text-secondary);
    max-width: 52ch;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2xs);
    margin-block-start: var(--space-2xs);
  }

  .empty {
    color: var(--text-muted);
    text-align: center;
    padding-block: var(--space-lg);
  }

  /* ── Responsive ─────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .metrics {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
      min-height: 0;
    }

    .steps {
      grid-template-columns: 1fr;
    }

    /* The flow becomes a vertical chain on mobile. */
    .flow {
      flex-direction: column;
      align-items: stretch;
    }

    .flow__step {
      flex-direction: column;
    }

    .flow__arrow {
      transform: rotate(90deg);
      align-self: center;
    }

    .flow__node {
      text-align: center;
    }
  }
</style>
