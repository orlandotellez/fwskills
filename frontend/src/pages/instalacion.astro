<script>
  /**
   * Scroll-spy for the sticky index. The active link follows the section
   * nearest the top of the reading area; the rootMargin keeps the header
   * from counting as the section being read.
   */
  function trackReadingPosition(): void {
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
    const sections = [...links]
      .map((link) => document.getElementById(link.dataset.tocLink ?? ''))
      .filter((section): section is HTMLElement => section !== null);

    if (links.length === 0 || sections.length === 0) return;

    const setActive = (id: string): void => {
      for (const link of links) {
        link.classList.toggle('is-active', link.dataset.tocLink === id);
      }
    };

    const visible = new Set<string>();

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            visible.add(entry.target.id);
          } else {
            visible.delete(entry.target.id);
          }
        }

        // First section in document order that is currently on screen.
        const first = sections.find((section) => visible.has(section.id));
        if (first) setActive(first.id);
      },
      { rootMargin: '-25% 0px -60% 0px', threshold: 0 },
    );

    for (const section of sections) observer.observe(section);
    setActive(sections[0]!.id);
  }

  trackReadingPosition();
</script>
