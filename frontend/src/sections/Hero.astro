---
import { ArrowRight, Sparkles } from 'lucide-astro';
---

<section class="hero">
  <div class="container grid-2 hero-grid">
    <div class="hero-copy">
      <span class="tag">
        <Sparkles size={14} />
        ¡Hola, fwinit!
      </span>
      <h1 class="hero-title">
        Tu landing, <span class="highlight">lista en segundos</span>
      </h1>
      <p class="hero-subtitle">
        Este proyecto nació de un solo comando —
        <code class="inline-code">fwinit astro mi-landing</code> — y ya es una
        landing completa: Astro 7, cero JavaScript en runtime y SEO listo.
      </p>
      <div class="hero-actions">
        <a class="btn-primary" href="#como-funciona">
          Ver cómo funciona
          <ArrowRight size={18} />
        </a>
        <a class="btn-secondary" href="https://github.com/orlandotellez/fwinit" target="_blank" rel="noopener">
          Scaffold propio
        </a>
      </div>
    </div>

    <div class="terminal" aria-label="Terminal de fwinit">
      <div class="terminal-bar">
        <span class="dot dot-red"></span>
        <span class="dot dot-yellow"></span>
        <span class="dot dot-green"></span>
        <span class="terminal-title">fwinit</span>
      </div>
      <div class="terminal-body">
        <p class="line"><span class="prompt">$</span> fwinit astro mi-landing</p>
        <p class="line ok">✓ Template ASTRO descargado</p>
        <p class="line ok">✓ Proyecto configurado en <span class="path">./mi-landing</span></p>
        <p class="line ok">✓ Listo para construir</p>
        <p class="line dim">$ cd mi-landing && npm install</p>
        <p class="line cursor"><span class="prompt">$</span> <span class="caret"></span></p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: var(--space-4xl) 0;
    background: var(--bg-base);
  }

  .hero-title {
    font-size: var(--text-5xl);
    margin: var(--space-md) 0 var(--space-md);
    letter-spacing: -0.02em;
  }

  .highlight {
    color: var(--primary-dark);
  }

  .hero-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    max-width: 520px;
    margin-bottom: var(--space-2xl);
  }

  .inline-code {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace;
    font-size: 0.9em;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.15rem 0.45rem;
    color: var(--primary-dark);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  /* ── Terminal card ── */
  .terminal {
    background: var(--footer-bg);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xl);
    overflow: hidden;
    border: 1px solid var(--border-strong);
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-lg);
    background: #1e293b;
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .dot-red { background: #f87171; }
  .dot-yellow { background: #fbbf24; }
  .dot-green { background: #34d399; }

  .terminal-title {
    margin-left: auto;
    margin-right: auto;
    font-family: ui-monospace, Menlo, monospace;
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .terminal-body {
    padding: var(--space-lg);
    font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace;
    font-size: var(--text-sm);
    line-height: 2;
    color: #cbd5e1;
  }

  .line { margin: 0; }

  .prompt {
    color: var(--secondary);
    font-weight: 700;
    margin-right: var(--space-sm);
  }

  .ok { color: #34d399; }

  .dim { color: var(--text-muted); }

  .path { color: #8aa2ff; }

  .caret {
    display: inline-block;
    width: 8px;
    height: 1.1em;
    background: #e2e8f0;
    vertical-align: text-bottom;
    animation: blink 1.1s steps(2, start) infinite;
  }

  @keyframes blink {
    to { visibility: hidden; }
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: var(--text-4xl);
    }
  }
</style>