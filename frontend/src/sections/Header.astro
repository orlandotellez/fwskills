---
import { Rocket, Github } from 'lucide-astro';
---

<header class="site-header">
  <div class="container header-inner">
    <a href="#" class="brand" aria-label="fwinit — inicio">
      <Rocket size={22} strokeWidth={2} class="brand-icon" />
      <span class="brand-name">fwinit</span>
    </a>
    <nav class="nav" aria-label="Principal">
      <a href="#features">Features</a>
      <a href="#design-skills">Skills</a>
      <a href="#como-funciona">Cómo funciona</a>
    </nav>
    <a class="btn-secondary header-cta" href="https://github.com/orlandotellez/fwinit" target="_blank" rel="noopener">
      <Github size={18} />
      <span>GitHub</span>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: var(--space-md);
    z-index: 100;
    background: transparent;
    border-bottom: none;
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    /* pill de vidrio flotante: el header es transparente y este chip
       queda "por encima" del contenido con blur, borde sutil y radius */
    height: calc(var(--header-height) - 16px);
    padding: 0 var(--space-lg);
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(16px) saturate(150%);
    -webkit-backdrop-filter: blur(16px) saturate(150%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-xl);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--text-primary);
  }

  .brand-icon {
    color: var(--primary-dark);
  }

  .nav {
    display: flex;
    gap: var(--space-xl);
    margin-left: auto;
  }

  .nav a {
    color: var(--text-secondary);
    font-weight: 500;
    font-size: var(--text-base);
  }

  .nav a:hover {
    color: var(--primary-dark);
  }

  .header-cta {
    padding: 0.5rem 1.25rem;
    font-size: var(--text-sm);
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
  }

  @media (max-width: 640px) {
    .nav {
      display: none;
    }
  }
</style>